# Copy to .env and fill in. NEVER commit the password or token.
# Active Directory domain (DNS name) and the service account used for LDAP.
AD_DOMAIN=ad.example.com
AD_USERNAME=svc-ad-mcp@ad.example.com
AD_PASSWORD=
# Comma-separated LDAP server URIs to use instead of DNS SRV discovery.
# e.g. ldaps://dc01.ad.example.com:636,ldap://dc02.ad.example.com:389
AD_LDAP_URIS=
# SIMPLE (default), NTLM or GSSAPI.
AD_AUTH_MECHANISM=SIMPLE
# Optional CA bundle path for trusting LDAPS server certificates.
AD_CA_CERT_FILE=
# Page size for large directory searches.
AD_SEARCH_PAGING_SIZE=100
# Bearer token that gates the network MCP endpoints (empty = auth disabled).
# Generate with: openssl rand -hex 32
AD_MCP_AUTH_TOKEN=
# AD_CONFIG_FILE=./ad.json